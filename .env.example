```env
# PostgreSQL Database Configuration
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_username
POSTGRES_PASSWORD=your_secure_database_password

# Database Connection URL
# Local development: use localhost
# Docker Compose: replace localhost with the PostgreSQL service name (e.g., postgres)
DATABASE_URL=postgresql+psycopg://your_database_username:your_secure_database_password@localhost:5432/your_database_name

# Path to the trained YOLO model
DETECTOR_MODEL_PATH=path/to/your/best.pt

# YOLO detection confidence threshold (0.0 to 1.0)
YOLO_CONFIDENCE=0.25
